{
  "name": "qlts",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @qlts/database db:generate",
    "db:push": "pnpm --filter @qlts/database db:push",
    "db:seed": "pnpm --filter @qlts/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "typescript": "^6.0.2"
  }
}
