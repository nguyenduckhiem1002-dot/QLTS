generator client {
  provider        = "prisma-client-js"
  // Load relations with a single JOIN query instead of one query per relation;
  // matters when every round trip to the database is slow.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  LOST
  DISPOSED
}

enum LocationType {
  OFFICE
  WAREHOUSE
  ROOM
  AREA
  OTHER
}

enum UserRole {
  ADMIN
  ASSET_MANAGER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id          String       @id @default(cuid())
  name        String       @unique
  type        LocationType @default(OFFICE)
  address     String?
  description String?
  assets      Asset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Employee {
  id           String            @id @default(cuid())
  employeeCode String            @unique
  name         String
  email        String?           @unique
  department   String?
  assets       Asset[]           @relation("CurrentCustodian")
  assignments  AssetAssignment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([name])
}

model Asset {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  serialNumber String?           @unique
  barcode      String?           @unique
  description  String?
  status       AssetStatus       @default(AVAILABLE)
  purchaseDate DateTime?
  purchaseCost Decimal?          @db.Decimal(14, 2)
  categoryId   String?
  locationId   String?
  custodianId  String?
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location     Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  custodian    Employee?         @relation("CurrentCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  assignments  AssetAssignment[]
  image        AssetImage?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([name])
  @@index([status])
  @@index([categoryId])
  @@index([locationId])
  @@index([custodianId])
}

model AssetImage {
  id        String   @id @default(cuid())
  assetId   String   @unique
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  employeeId String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  note       String?
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([assetId, assignedAt])
  @@index([employeeId, assignedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actor      String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String
  passwordHash       String?
  role               UserRole         @default(VIEWER)
  status             UserStatus       @default(INVITED)
  mustChangePassword Boolean          @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           UserSession[]
  invitations        UserInvitation[]

  @@index([role, status])
  @@index([name])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserInvitation {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
